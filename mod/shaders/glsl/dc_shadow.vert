#version 460
// Карта теней: та же вершина, но спроецированная ИЗ ЛАМПЫ (18.09.2026).
// Вершины приходят в экранном пространстве PS1 плюс PGXP w, поэтому видовая
// точка восстанавливается обратной перспективой — ровно как в dc_raster.vert.
// Ламп теперь несколько: каждая рисуется в свой слой массива, её номер
// приходит в pc.wd.w, а матрицы лежат в блоке ShadowUBO (общем с растром).
layout(location = 0) in vec2 in_pos;
layout(location = 1) in vec2 in_uv;
layout(location = 2) in vec4 in_color;
layout(location = 3) in vec4 in_info;
layout(location = 4) in float in_w;

layout(push_constant) uniform PC {
    vec4 view;
    vec4 params;
    vec4 prevRect;
    vec4 prevMap;
    vec4 wq;
    vec4 wt;
    vec4 wd;          // w = номер лампы на этом проходе
    vec4 wp;          // ox, oy, H, H * сжатие по горизонтали
} pc;

layout(binding = 4, std140) uniform ShadowUBO {
    mat4 vp[4];       // видовая точка нашей камеры -> отсечённое пространство лампы
    vec4 par[4];      // сила, A, B (линеаризация глубины), полутень
    vec4 lpos[4];     // xyz — лампа в видовом пространстве, w — её радиус
    vec4 cfg;         // число ламп, смещение (мировых единиц), 1/размер карты, отладка
    vec4 cfg2;
} sh;

void main() {
    // Окклюдер здесь только ПОДВИЖНОЕ: свет комнаты уже запечён в её вершинах,
    // и затенять её собственной геометрией значит красить тень дважды.
    // Остальное уводим за ближнюю плоскость — отсечётся.
    // 18.09 вечер: окклюдер — ЛЮБОЙ персонаж (F_ACTOR 16 у Регины, F_CHAR
    // 8388608 у NPC и зверей): игрок просил тени и от них.
    // ...и только СПЛОШНОЙ: полупрозрачное (F_SEMI 2) тени не отбрасывает,
    // иначе её отбрасывал бы и сам диск-«тень» игры, и кровь под ногами.
    int fl = int(round(in_info.w));
    // 25.09 ночь (игрок: «за кадром полигоны персонажей режутся и с ними режется их тень»): полигоны персонажа, которые
    // игра не рисует (за краем кадра, спиной к камере), приходят сюда отдельно, уже в видовом пространстве — метка
    // in_uv.x = -1000 (обычные UV 0..255): x, y, w вершины и есть точка. Позади камеры они тоже годятся.
    const bool vsp = in_uv.x < -500.0;
    if ((fl & (16 | 8388608)) == 0 || (fl & 2) != 0 || (!vsp && in_w < 1.5)) {
        gl_Position = vec4(0.0, 0.0, -2.0, 1.0);
        return;
    }
    float w = max(in_w, 1e-6);
    vec3 p = vsp ? vec3(in_pos, in_w)
                 : vec3((in_pos.x - pc.wp.x) * w / pc.wp.w,
                        (in_pos.y - pc.wp.y) * w / pc.wp.z,
                        w);
    int idx = clamp(int(pc.wd.w + 0.5), 0, 3);
    // ⛔ 18.09 вечер: здесь СТОЯЛО отсечение окклюдера по радиусу лампы, и
    // резало оно ПОВЕРШИННО — у персонажа на границе часть модели в карту не
    // попадала, и тень обрывалась прямой линией (игрок: «обрезка по краю»).
    // Лампа, которая объект не освещает, теперь гасится плавно в
    // dc_raster.frag по расстоянию заслонившего (focc).
    gl_Position = sh.vp[idx] * vec4(p, 1.0);
}
